# Local IP address of a Shelly Gen2/Gen3 plug with power monitoring.
SHELLY_URL=http://192.168.1.50

# Supabase Edge Function URL, for example:
# https://YOUR_PROJECT_REF.supabase.co/functions/v1/device-telemetry
SUPABASE_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/device-telemetry

# Values created when the plug is registered in Supabase.
DEVICE_ID=00000000-0000-0000-0000-000000000000
DEVICE_TOKEN=replace-with-a-long-random-secret

POLL_SECONDS=15
RUNNING_GUARD_W=5
HTTP_TIMEOUT=8
