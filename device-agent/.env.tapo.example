# Copy this file to ".env" (same folder) and fill in the values.

# Tapo P110: IP address of the plug in your Wi-Fi (see the router or the Tapo app).
TAPO_HOST=192.168.1.50
# The email and password of your Tapo (TP-Link) account.
TAPO_EMAIL=you@example.com
TAPO_PASSWORD=your-tapo-password

# Values of the plug registered in Supabase (smart_plugs row + token).
SUPABASE_FUNCTION_URL=https://nsnnxdjvbkjovlieyeat.supabase.co/functions/v1/device-telemetry
DEVICE_ID=00000000-0000-0000-0000-000000000000
DEVICE_TOKEN=replace-with-the-long-secret-token

POLL_SECONDS=5
RUNNING_GUARD_W=5
